# LoL Remote Pick - Environment Configuration

# Web Server Port (default: 8000)
# Change this if port 8000 is occupied or if you prefer another port (e.g. 8080, 5000)
PORT=8000

# Host to bind (0.0.0.0 listens on all LAN adapters for smartphone access)
HOST=0.0.0.0

# Run in Mock Simulation Mode without League of Legends client (true / false)
MOCK_MODE=false

# Optional custom install path to League of Legends or lockfile
# CUSTOM_LEAGUE_PATH=D:\Riot Games\League of Legends
