{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/format_edited_file.py\" 2>/dev/null || python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/format_edited_file.py\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Formatting edited file..."
          }
        ]
      }
    ]
  }
}
